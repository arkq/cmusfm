/* Define to 1 if debugging is enabled. */
#cmakedefine DEBUG 1

/* Define to 1 if libnotify is enabled. */
#cmakedefine ENABLE_LIBNOTIFY 1

/* Define to 1 if sys/inotify.h is available. */
#cmakedefine HAVE_SYS_INOTIFY_H 1

/* Define to 1 if system MD5 is used. */
#cmakedefine WITH_SYSTEM_MD5 1
